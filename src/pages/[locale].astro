---
/** Locale route: static pages are generated only for supported non-default languages. */
import GuidePage from "../components/GuidePage.astro";
import { locales, type Locale } from "../data/guide";

export function getStaticPaths() {
  return locales.filter((locale) => locale !== "ms").map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Exclude<Locale, "ms">;
---
<GuidePage {locale} />
