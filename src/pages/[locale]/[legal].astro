---
/** Supported legal pages for English and Simplified Chinese locale routes. */
import LegalPage from "../../components/LegalPage.astro";
import { locales, type Locale } from "../../data/guide";
import { legalPages, type LegalPageKey } from "../../data/legal";

export function getStaticPaths() {
  return locales.filter((locale) => locale !== "ms").flatMap((locale) => legalPages.map((legal) => ({ params: { locale, legal } })));
}

const locale = Astro.params.locale as Exclude<Locale, "ms">;
const page = Astro.params.legal as LegalPageKey;
---
<LegalPage {locale} page={page} />
